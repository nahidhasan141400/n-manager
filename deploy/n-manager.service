[Unit]
Description=N Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nmanager
Group=nmanager
ExecStart=/usr/bin/n-manager --config /etc/n-manager/config.yaml
WorkingDirectory=/var/lib/n-manager
Restart=on-failure
RestartSec=2
UMask=0027
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/n-manager /etc/n-manager /var/log/n-manager
PrivateTmp=true

[Install]
WantedBy=multi-user.target
